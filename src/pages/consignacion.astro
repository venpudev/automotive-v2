---
import Layout from "../layouts/Layout.astro";
import consignacionBg from "../assets/images/consignacion.png";
---

<Layout 
  title="Consigna tu Auto - Automotive Consulting" 
  description="Vende tu auto de forma segura, rápida y al mejor precio del mercado con nuestro servicio de consignación."
>
  <section class="relative overflow-hidden text-white">
    <img
      src={consignacionBg}
      alt="Consignación Automotive Consulting"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/55 to-black/20"></div>
    <div class="absolute -top-32 -left-16 w-72 h-72 bg-[#21b4c2]/40 blur-3xl rounded-full"></div>
    <div class="absolute bottom-0 right-0 w-80 h-80 bg-[#21b4c2]/25 blur-3xl rounded-full"></div>

    <div class="relative max-w-6xl mx-auto px-4 pt-44 pb-20">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 bg-white/10 text-white text-sm font-semibold px-4 py-1.5 rounded-full">
          <svg class="w-4 h-4 text-[#21b4c2]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2a7 7 0 0 0-7 7c0 4.97 5.33 11.02 6.45 12.26a.75.75 0 0 0 1.1 0C13.67 20.02 19 13.97 19 9a7 7 0 0 0-7-7Zm0 10a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"/>
          </svg>
          Consignación segura
        </span>
        <h1 class="text-4xl md:text-5xl font-bold mt-5 mb-4">
          Deja tu auto y lo vendemos por ti
        </h1>
        <p class="text-lg text-gray-200">
          Gestión completa + seguro durante todo el proceso.
        </p>
        <div class="mt-7 flex flex-col sm:flex-row sm:items-center gap-4">
          <a
            href="https://wa.me/56976225094?text=Hola%20Automotive%2C%20quiero%20consignar%20mi%20auto.%20%C2%BFMe%20ayudan%20con%20el%20proceso%3F"
            class="inline-flex items-center justify-center gap-3 bg-[#21b4c2] text-white font-bold px-8 py-4 rounded-full shadow-lg shadow-[#21b4c2]/40 hover:shadow-[#21b4c2]/60 hover:scale-[1.02] transition-all duration-200"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2C6.55 2 2.1 6.47 2.1 12c0 1.95.53 3.77 1.46 5.33L2 22l4.8-1.5A9.84 9.84 0 0 0 12.04 22C17.53 22 22 17.53 22 12S17.53 2 12.04 2Zm4.7 14.18c-.2.56-1.16 1.06-1.6 1.12-.4.06-.9.1-1.46-.1-.34-.1-.77-.25-1.32-.48-2.33-1-3.86-3.43-3.97-3.58-.1-.15-.94-1.24-.94-2.37 0-1.12.57-1.67.77-1.9.2-.24.45-.3.6-.3h.44c.14 0 .33-.05.52.4.2.48.68 1.65.74 1.77.06.12.1.28.02.43-.07.15-.12.28-.24.43-.12.14-.25.31-.36.41-.12.12-.24.25-.1.48.15.24.64 1.06 1.37 1.72.95.87 1.76 1.14 2.02 1.26.25.12.4.1.55-.06.15-.17.63-.73.8-.99.17-.25.33-.2.55-.12.23.08 1.44.68 1.7.8.25.12.42.18.48.28.06.1.06.58-.14 1.14Z"/>
            </svg>
            Hablar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <main class="bg-white py-16 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-gray-200 p-8 text-center shadow-sm hover:shadow-lg transition-shadow">
          <div class="w-16 h-16 mx-auto rounded-2xl bg-[#21b4c2]/15 text-[#21b4c2] flex items-center justify-center">
            <svg class="w-9 h-9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 3a9 9 0 1 0 9 9 9.01 9.01 0 0 0-9-9Zm1 9h4v2h-6V7h2Z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mt-4">Gestión completa</h3>
          <p class="text-gray-600 mt-2">Publicación, visitas y negociación.</p>
        </div>
        <div class="rounded-2xl border border-gray-200 p-8 text-center shadow-sm hover:shadow-lg transition-shadow">
          <div class="w-16 h-16 mx-auto rounded-2xl bg-[#21b4c2]/15 text-[#21b4c2] flex items-center justify-center">
            <svg class="w-9 h-9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2 3 6v6c0 5 3.8 9.6 9 10 5.2-.4 9-5 9-10V6Zm0 18c-3.6-.4-6-3.6-6-6.8V7.2l6-2.4 6 2.4v6c0 3.2-2.4 6.4-6 6.8Z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mt-4">Seguro incluido</h3>
          <p class="text-gray-600 mt-2">Resguardo durante la consignación.</p>
        </div>
        <div class="rounded-2xl border border-gray-200 p-8 text-center shadow-sm hover:shadow-lg transition-shadow">
          <div class="w-16 h-16 mx-auto rounded-2xl bg-[#21b4c2]/15 text-[#21b4c2] flex items-center justify-center">
            <svg class="w-9 h-9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M4 4h16v4H4zm0 6h10v10H4zm12 0h4v10h-4z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mt-4">Venta ágil</h3>
          <p class="text-gray-600 mt-2">Compradores calificados.</p>
        </div>
      </div>
    </div>
  </main>
</Layout>
